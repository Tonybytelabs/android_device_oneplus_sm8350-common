<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy of SetupWizardPixelPrebuilt_v802960446 res/raw/wizard_script_minors_setup_personalization_flow with the
     "opa" (Assistant opt-in) action removed. That action starts
     com.google.android.googlequicksearchbox, which pico/core builds do not
     install, and the wizard never leaves the page when the launch fails. -->
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">
        <!-- Satellite and car crash detection. [PIXEL] -->
    <WizardAction id="personal_safety" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.apps.safetyhub;action=com.google.android.apps.safetyhub.setupflow.safetysuw.SAFETY;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.safetyhub.SatelliteAndCarCrashDetectionContract">
    </WizardAction>

    <!-- Set up Quick Share. This step is required for kids accounts. [REQUIRED] -->
    <WizardAction id="quick_share"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.QUICK_SHARE;end" />

    <WizardAction id="END_OF_PERSONALIZATION" />

</WizardScript>
