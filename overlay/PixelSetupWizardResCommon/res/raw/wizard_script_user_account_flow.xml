<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy of SetupWizardPixelPrebuilt_v802960446 res/raw/wizard_script_user_account_flow with the
     "opa" (Assistant opt-in) action removed. That action starts
     com.google.android.googlequicksearchbox, which pico/core builds do not
     install, and the wizard never leaves the page when the launch fails. -->
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- Set up biometric screen lock [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="biometric"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.BIOMETRIC;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.BiometricLockWrapperContract">
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="google_services" />
    </WizardAction>

    <!-- Set screen lock options [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="lock_screen"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.LOCK_SCREEN;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.LockScreenWrapperContract" />

    <!-- Show service opt-ins, as well as terms of service [REQUIRED] -->
    <WizardAction id="google_services"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.GOOGLE_SERVICES;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.GoogleServicesWrapperContract">
        <result wizard:name="unintentional_cancel"
            wizard:resultCode="102"
            wizard:action="rollback_auth_early_update" />
        <result wizard:action="search_selector" />
    </WizardAction>

    <!-- Script that includes steps to rollback auth early update [REQUIRED] -->
    <WizardAction id="rollback_auth_early_update"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_rollback_auth_early_update_flow">
        <result wizard:action="google_services" />
    </WizardAction>

    <!-- Show search selector screen [REQUIRED] -->
    <WizardAction id="search_selector"
        wizard:uri="intent:#Intent;package=com.google.android.apps.setupwizard.searchselector;action=com.google.android.setupwizard.SELECT_SEARCH_ENGINE;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.searchselector.DseFlowControlContract" />

    <!-- Perform additional optional steps (while waiting for restoration to complete) [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="suggested_actions"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.SUGGESTED_ACTIONS;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.user.SuggestedActionsWrapperContract" />

    <!-- Wait for high-priority apks to be completed [RECOMMENDED] -->
    <WizardAction id="final_hold" wizard:ifFlow="UserAccountFlow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.FINAL_HOLD;end"
        wizard:node="contract:com.google.android.setupwizard.contract.account.FinalHoldContract" />

    <!-- Wait for launcher layout to load [RECOMMENDED] -->
    <WizardAction id="load_launcher_layout"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.LOAD_LAUNCHER_LAYOUT;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.LoadLauncherLayoutContract" />

</WizardScript>
