<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy of SetupWizardPixelPrebuilt_v802960446 res/raw/wizard_script_common_personalization_flow with the
     "opa" (Assistant opt-in) action removed. That action starts
     com.google.android.googlequicksearchbox, which pico/core builds do not
     install, and the wizard never leaves the page when the launch fails. -->
<!--
    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- moment page. If this page show, not show opa -->
    <WizardAction id="moment"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.google.android.pixel.setupwizard.MOMENT_ACTIVITY;end">
        <result wizard:name="flag_off"
            wizard:resultCode="101"
            wizard:action="spoon" />
        <result wizard:name="minor_account"
            wizard:resultCode="102"
            wizard:action="spoon" />
        <result wizard:name="capability_fail"
            wizard:resultCode="103"
            wizard:action="spoon" />
        <result wizard:name="assist_opt_in"
            wizard:resultCode="105"
            wizard:action="spoon" />
    </WizardAction>

    <!-- assistant page. Which will introduce google built-in assitant-->
    <WizardAction id="assist_info"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.google.android.pixel.setupwizard.ASSISTANT_ACTIVITY;end">
        <result wizard:action="spoon" />
    </WizardAction>

    <!-- spoon wrapper. Which will show spoon page -->
    <WizardAction id="spoon"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.google.android.pixel.setupwizard.PIXEL_SPOON;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.SpoonWrapperContract" />

    <!-- Subzero wrapper. Which will show the subzero page -->
    <WizardAction id="subzero"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.google.android.pixel.setupwizard.PIXEL_SUBZERO;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.SubZeroWrapperContract" />

    <!-- agent wrapper. Which will show agent page -->
    <WizardAction id="agent"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.google.android.pixel.setupwizard.PIXEL_AGENT;end"/>

    <!-- dialer joyball wrapper. Which will show dialer joyball page -->
    <WizardAction id="dialer_joyball"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.google.android.pixel.setupwizard.DIALER_JOYBALL;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.DialerJoyballWrapperContract" />

    <!-- Satellite and car crash detection. [PIXEL] -->
    <WizardAction id="personal_safety" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.apps.safetyhub;action=com.google.android.apps.safetyhub.setupflow.safetysuw.SAFETY;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.safetyhub.SatelliteAndCarCrashDetectionContract">
    </WizardAction>

    <!-- Set up Quick Share. This step should come right after Google Services. [REQUIRED] -->
    <WizardAction id="quick_share"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.QUICK_SHARE;end" />

    <!-- Set up payment method. Ensure at least one of the wizard actions biometric or lock_screen
        must precede the payments action [RECOMMENDED] -->
    <WizardAction id="payment"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.PAYMENTS;end"
        wizard:node="contract:com.google.android.setupwizard.contract.account.PaymentsWrapperContract" />

    <WizardAction id="find_my_device" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.FIND_MY_DEVICE;end"
        wizard:node="contract:com.google.android.setupwizard.contract.account.FindMyDeviceWrapperContract" />

    <!-- Perform additional optional steps (while waiting for restoration to complete) [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="suggested_actions"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.SUGGESTED_ACTIONS;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.user.SuggestedActionsWrapperContract" />

    <!-- Last screen shown to the user [PIXEL] -->
    <WizardAction id="closing"
        wizard:uri="intent:#Intent;action=com.google.android.pixel.setupwizard.PIXEL_CLOSING;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.ClosingContract">
        <result wizard:action="set_exit_action" />
    </WizardAction>

    <!-- Catch Activity result from closing activity [PIXEL] -->
    <WizardAction id="set_exit_action"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.SET_EXIT_ACTION;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.SetExitActionContract" />

    <WizardAction id="END_OF_PERSONALIZATION" />

</WizardScript>
